{
  "name": "ai-academic-tutor",
  "version": "1.0.0",
  "description": "AI-powered academic tutor with document processing and voice capabilities",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && CI=false npm run build",
    "start": "node server.js",
    "start:production": "npm run build && node server.js",
    "install-all": "npm install && cd client && npm install",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "xlsx": "^0.18.5",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "@pinecone-database/pinecone": "^2.0.1",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "@deepgram/sdk": "^3.4.0",
    "groq-sdk": "^0.5.0",
    "@xenova/transformers": "^2.17.1",
    "ws": "^8.16.0",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.2",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "ai",
    "tutor",
    "education",
    "rag",
    "voice",
    "deepgram",
    "pinecone"
  ],
  "author": "AI Academic Tutor",
  "license": "MIT"
}
